# From the GitHub App settings page (Developer settings → GitHub Apps → your app).
GITHUB_APP_ID=123456

# The .pem you downloaded, as one line with literal \n between lines, or a real
# multi-line value in a .env file. Both forms are normalised at load.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# The webhook secret you set on the same page. Deliveries fail closed without it.
GITHUB_WEBHOOK_SECRET=

# advisory: a strategic blocker resolves to a neutral check (default, and the
# right setting until a team trusts the reviewer).
# required: it resolves to action_required and can gate a merge.
WATCHMAN_GATE_MODE=advisory

# The reviewer's model access. Without it the app still runs preflight and
# still refuses broken installations — it just cannot produce a verdict.
ANTHROPIC_API_KEY=

# Local development only — the Inngest dev server needs no keys.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Your smee.io channel, for forwarding real deliveries to localhost.
# SMEE_URL=https://smee.io/xxxxxxxx
